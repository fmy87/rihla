VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Must have Maps JavaScript API, Places API, and Directions API enabled —
# the Route Editor (Phase 5) uses address search (Places) and road-based
# route lines (Directions) in addition to the base map.
VITE_MAP_API_KEY=
# Base URL of the deployed parent portal (apps/parent-portal) — used to build
# the shareable invite link shown to admins on the Students page. Falls back
# to a placeholder in the UI if unset, so this is safe to leave blank until
# the parent portal has its own domain.
VITE_PARENT_PORTAL_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key is used ONLY by trusted server-side contexts
# (Supabase Edge Functions). Never expose in the admin web or driver app bundles.
SUPABASE_SERVICE_ROLE_KEY=

# Maps (Google Maps — see docs/map-and-localization.md)
MAP_PROVIDER=google
MAP_API_KEY=

# App
DEFAULT_LANGUAGE=en
APP_ENV=development

# Driver app specific (Expo)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAP_API_KEY=
# Single-school deployments only; multi-school driver login (school picker)
# is a Phase 12+ enhancement.
EXPO_PUBLIC_SCHOOL_ID=

# Parent portal specific (apps/parent-portal) — separate .env/build from the
# admin app, see apps/parent-portal/.env.example
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Base URL of the deployed parent portal, used by the admin app to build
# shareable "Invite parent" links (apps/admin/.env.example) — set this to
# match wherever apps/parent-portal actually gets deployed.
VITE_PARENT_PORTAL_URL=
